#!/bin/bash

# Copy data files to the binder environment
mkdir -p docs/data
cp -r docs/data/* docs/data/ 2>/dev/null || true

# Install pupeyes package using setup.py
pip install -e .

# Set up Jupyter kernel
python -m ipykernel install --user --name pupeyes --display-name "PupEyes"

echo "PupEyes environment setup complete!" 